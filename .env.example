# PostgreSQL
POSTGRES_DB=lead-intelligence
POSTGRES_USER=app
# Задай собственный пароль перед запуском и не публикуй его.
POSTGRES_PASSWORD=change_me_before_starting

# GitHub API: добавь собственный Personal Access Token.
GITHUB_TOKEN=

# Прокси для внешних запросов LLM.
# Если локальный прокси не запущен на host.docker.internal:1338, укажи свой адрес или оставь пустым.
PROXY=socks5h://host.docker.internal:1338

# Дополнительные прокси (необязательно).
PROXY_COLLECTORS=
PROXY_GITHUB=

# Коллекторы площадок
COLLECTOR_SIZE_KWORK=10
RANDOM_FLAG=false
RUNNER_COLLECTORS=false
RUNNER_COLLECTORS_INTERVAL=100

# GitHub discovery pipeline
# Запускать pipeline при старте планировщика.
DISCOVERY_RUN_ON_START=false
# Периодически запускать pipeline. При false автоматический запуск отключён.
DISCOVERY_RUN_WORK=false
DISCOVERY_INTERVAL_MINUTES=100

# Ограничения GitHub-сбора
MAX_REPOSITORIES_PER_WORD=1
MAX_ISSUES_PER_WORD=3
MAX_COMMENTS_PER_WORD=2
MAX_GITHUB_REQUESTS_PER_RUN=1500
DISCOVERY_WORDS_PER_RUN=2

# LLM providers
# Ключи оставлены пустыми намеренно: заполни их, если используешь внешние провайдеры.
OPENROUTER_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GEMINI_KEY=

# true включает профиль Docker Compose с Ollama; false отключает его.
OLLAMA=true
MAX_ERROR_LLM_RETRIES_FOR_EVERY_MODEL=2

# Дополнительный LLM-анализ сопоставления профилей
LLM_SELF_PROFILE_ANALITIC=true
